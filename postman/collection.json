              "path": ["api", "v1", "reconciliation", "jobs"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateway_id\": \"fib\",\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"period_start\": \"2026-01-01T00:00:00Z\",\n  \"period_end\": \"2026-01-31T23:59:59Z\"\n}"
            },
            "auth": {
              "type": "apikey",
