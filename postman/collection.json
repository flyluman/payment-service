            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Ops-Token",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{ops_token}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Initiate a refund. FIB only supports full refunds. Requires ops token."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Cancels",
