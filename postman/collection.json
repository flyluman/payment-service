{
  "info": {
    "name": "Payment Service API (FIB)",
    "description": "Payment Service API collection with FIB (Fast Iraqi Bank) gateway. Covers all 33 routes for server-to-server calls, browser checkout, webhooks, manual capture, reconciliation, and tenant webhook configs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Service-Token",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{service_token}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "tenant_id",
      "value": "00000000-0000-0000-0000-000000000001"
    },
    {
      "key": "transaction_id",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "gateway_id",
      "value": "fib"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "auth": null,
            "description": "DB + Valkey connectivity check. No auth required."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Gateways",
      "item": [
        {
          "name": "List Gateways",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/gateways?amount=50000&currency=IQD",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "gateways"],
              "query": [
                {
                  "key": "amount",
                  "value": "50000",
                  "description": "Amount for per-gateway, per-method fee estimation"
                },
                {
                  "key": "currency",
                  "value": "IQD",
                  "description": "Currency for per-gateway, per-method fee estimation"
                }
              ]
            },
            "description": "List all active gateways. Tenant is resolved from the authenticated service token (ops tokens list without per-tenant FX rates). Include amount + currency to get a per-method fee_breakdowns map (keyed by payment method), same structure as the create-payment response."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Tenant Gateways",
      "item": [
        {
          "name": "List Tenant Gateways",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/gateways",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "gateways"]
            },
            "description": "List gateway configurations for a tenant."
          },
          "response": []
        },
        {
          "name": "Get Tenant Gateway",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/gateways/{{gateway_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "gateways", "{{gateway_id}}"]
            },
            "description": "Get a single tenant gateway config."
          },
          "response": []
        },
        {
          "name": "Upsert Tenant Gateway (FIB)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/gateways",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "gateways"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateway_id\": \"fib\",\n  \"provider\": \"fib\",\n  \"config\": {\n    \"client_id\": \"fib-client-id\",\n    \"client_secret\": \"fib-client-secret\",\n    \"base_url\": \"https://fib-sandbox.example.com\",\n    \"callback_url\": \"http://localhost:8080/webhooks/gateway/fib\"\n  },\n  \"is_active\": true\n}"
            },
            "description": "Create or update FIB gateway configuration for a tenant."
          },
          "response": []
        },
        {
          "name": "Delete Tenant Gateway",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/api/v1/tenants/{{tenant_id}}/gateways/{{gateway_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "tenants", "{{tenant_id}}", "gateways", "{{gateway_id}}"]
            },
            "description": "Delete a tenant gateway config."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create Payment (FIB)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.transaction_id) {",
                  "    pm.collectionVariables.set('transaction_id', res.data.transaction_id);",
                  "    pm.collectionVariables.set('token', res.data.token);",
                  "    console.log('Saved transaction_id:', res.data.transaction_id);",
                  "    console.log('Saved token:', res.data.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/payments",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments"]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{$guid}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"gateway_id\": \"fib\",\n  \"amount\": 50000,\n  \"currency\": \"IQD\",\n  \"payment_method\": \"card\",\n  \"customer_id\": \"11111111-1111-1111-1111-111111111111\",\n  \"customer_email\": \"customer@example.com\",\n  \"description\": \"Order #12345 - Premium Plan\",\n  \"metadata\": {\n    \"order_id\": \"12345\",\n    \"product\": \"Premium Plan\"\n  },\n  \"callback_url\": \"http://myapp.com/api/webhooks/payment\",\n  \"redirect_url\": \"https://myapp.com/order/12345/complete\"\n}"
            },
            "description": "Create a payment with FIB gateway. Returns transaction_id and token. The test script auto-saves these as collection variables."
          },
          "response": []
        },
        {
          "name": "Get Payment",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{transaction_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "{{transaction_id}}"]
            },
            "description": "Get payment status and details. Returns raw_metadata with FIB QR code."
          },
          "response": []
        },
        {
          "name": "List Payments",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/payments?limit=10&status=PENDING,CAPTURED,FAILED",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments"],
              "query": [
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Page size (1-100)"
                },
                {
                  "key": "status",
                  "value": "PENDING,CAPTURED,FAILED",
                  "description": "Filter by status"
                }
              ]
            },
            "description": "List payments with filters. Service tokens are tenant-scoped."
          },
          "response": []
        },
        {
          "name": "List Payments (CSV)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/payments?limit=100",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments"],
              "query": [
                {
                  "key": "limit",
                  "value": "100",
                  "description": "Page size"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "text/csv"
              }
            ],
            "description": "Download transactions as CSV (Accept: text/csv header)."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Manual Capture",
      "item": [
        {
          "name": "Authorize Payment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{transaction_id}}/authorize",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "{{transaction_id}}", "authorize"]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Ops-Token",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{ops_token}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Authorize a PENDING/PROCESSING payment (manual capture flow). Requires ops token. No request body."
          },
          "response": []
        },
        {
          "name": "Capture Payment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{transaction_id}}/capture",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "{{transaction_id}}", "capture"]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Ops-Token",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{ops_token}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Capture an AUTHORIZED payment (manual capture flow). Requires ops token. No request body."
          },
          "response": []
        },
        {
          "name": "Settle Payment",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{transaction_id}}/settle",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "{{transaction_id}}", "settle"]
            },
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "key",
                  "value": "X-Ops-Token",
                  "type": "string"
                },
                {
                  "key": "value",
                  "value": "{{ops_token}}",
                  "type": "string"
                },
                {
                  "key": "in",
                  "value": "header",
                  "type": "string"
                }
              ]
            },
            "description": "Settle a CAPTURED payment (manual capture flow). Requires ops token. No request body."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Refunds",
      "item": [
        {
          "name": "Initiate Refund",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{base_url}}/api/v1/payments/{{transaction_id}}/refunds",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "payments", "{{transaction_id}}", "refunds"]
