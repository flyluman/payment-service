# Payment Service — env overrides for local dev.
#
# Copy to `.env`. Full binding list: config/config.go (envBindings in LoadConfig).
# Baseline keys live in config.yaml; README §30 lists essentials.

# ── Auth (required to start) ────────────────────────────────────────────
# Service tokens: token=tenantID:userID,...
SERVICE_TOKENS=test-token=11111111-1111-1111-1111-111111111111:22222222-2222-2222-2222-222222222222
# Ops tokens: token,token,...
OPS_TOKENS=ops-token

# ── Secrets ──────────────────────────────────────────────────────────────
# Database password (config.yaml default: payment)
DATABASE_PASSWORD=payment
# Envelope encryption key (32-byte hex) for gateway credentials at rest.
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=

# ── AWS SDK (not config-bindable; required for Floci SNS) ───────────────
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# ── Other secrets (non-local environments) ──────────────────────────────
# SMTP (email delivery)
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMS (stub — no recipient source on txn)
# SMS_API_KEY=
# mTLS cert/key paths (empty = plain HTTP)
# TLS_CERT_FILE=
# TLS_KEY_FILE=
# TLS_CA_FILE=
