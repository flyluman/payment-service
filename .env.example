# ── Encryption ────────────────────────────────────────────────────────
# Hex-encoded 256-bit key for gateway credential encryption at rest.
# Without this, credentials in tenant_gateway_configs stored as plaintext.
# Generate one with: openssl rand -hex 32
# ENCRYPTION_KEY=...

# ── Config path ───────────────────────────────────────────────────────
# CONFIG_PATH=/custom/config.yaml

# ── Auth ─────────────────────────────────────────────────────────────
# Service tokens: token=tenantID:userID,...
SERVICE_TOKENS=test-token=11111111-1111-1111-1111-111111111111:22222222-2222-2222-2222-222222222222
# Ops tokens: token,token,...
OPS_TOKENS=

# ── Database ──────────────────────────────────────────────────────────
DATABASE_NAME=payment_dev
DATABASE_USER=payment
DATABASE_PASSWORD=payment
DATABASE_PRIMARY_HOST=localhost
DATABASE_SSL_MODE=disable

# ── Valkey ────────────────────────────────────────────────────────────
VALKEY_ADDRS=localhost:6379

# ── App ───────────────────────────────────────────────────────────────
ENVIRONMENT=dev
PORT=8080
